<Window
    x:Class="SalesWiZ.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SalesWiZ.Views"
    Title="SalesWiZ">

    <Grid>
        <!-- Main shell: shown once logged in. -->
        <NavigationView x:Name="NavView"
                        Visibility="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Header>
                <TextBlock x:Name="NavHeaderText" Text="Dashboard"
                           FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="Leads" Tag="Leads" Icon="People" />
                <NavigationViewItem Content="Inbox" Tag="Inbox" Icon="Mail" />
                <NavigationViewItem Content="Interest" Tag="Interest" Icon="Favorite" />
                <NavigationViewItem Content="Actions" Tag="Actions" Icon="List" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Sign out" Tag="SignOut" Icon="Go" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Login layer: covers the shell until the user is logged in. -->
        <Grid x:Name="LoginLayer" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <views:LoginPage x:Name="LoginControl" LoginSucceeded="LoginControl_LoginSucceeded" />
        </Grid>
    </Grid>
</Window>
