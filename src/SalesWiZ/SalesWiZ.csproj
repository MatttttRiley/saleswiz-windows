<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SalesWiZ</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- GitHub-hosted runners have no Visual Studio AppxPackage MSBuild
         tooling, so the WindowsAppSDK PRI generation fails with MSB4062
         (ExpandPriContent cannot load Microsoft.Build.Packaging.Pri.Tasks
         from the .NET SDK folder). Enabling the MSIX tooling makes PRI
         generation use the tasks shipped inside the WindowsAppSDK NuGet
         package itself (tools/net6.0/Microsoft.Build.Msix.dll) instead.
         This does NOT produce an MSIX: packaging only happens with
         /p:GenerateAppxPackageOnBuild=true, which we don't pass, and
         WindowsPackageType stays None (unpackaged exe folder). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged desktop app: no MSIX, the Windows App Runtime ships
         alongside the exe (self-contained), so the user just runs it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SalesWiZ</AssemblyName>
    <Version>1.1.0.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Assets\SalesWiZ.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- The package manifest is only an AppxManifest item for packaged
       builds. Microsoft.Build.Msix.Packaging.targets errors out when
       WindowsPackageType is None but an AppxManifest is specified
       ("Improper project configuration: WindowsPackageType is set to
       None, but a AppxManifest is specified"), and Microsoft Learn's
       unpackaged-app instructions say to delete the manifest from the
       project for the same reason. Unpackaged apps have no package
       identity, so the manifest's identity/capabilities/tile entries
       do not apply at runtime anyway. The file stays on disk (and in
       the repo) so a future packaged build just works: this condition
       re-includes it automatically if WindowsPackageType is ever
       changed away from None. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>
</Project>
