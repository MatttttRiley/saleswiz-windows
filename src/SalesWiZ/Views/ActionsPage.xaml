<Page
    x:Class="SalesWiZ.Views.ActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalesWiZ.Views"
    xmlns:core="using:SalesWiZ">

    <Grid>
        <ScrollViewer x:Name="ContentScroll" Padding="24" Visibility="Collapsed">
            <StackPanel Spacing="16" MaxWidth="860">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Actions" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Center" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Calls left today" />
                        <TextBlock x:Name="CallsLeftText" Grid.Column="1" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FollowupsHeader" Text="Follow-ups due" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="FollowupsList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="LeadList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:FollowupLead">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind DisplayCity}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind local:ActionsPage.DueText(FollowUpDue)}"
                                                   Foreground="Orange" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="FollowupsEmpty" Text="Nothing due. Nice."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CallQueueHeader" Text="Call queue" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="CallQueueList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="LeadList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:CallQueueLead">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind DisplayCity}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Phone}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Call" Tag="{x:Bind TelUri}"
                                                Click="CallButton_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="CallQueueEmpty" Text="The call queue is empty."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="NextBatchHeader" Text="Next batch" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="NextBatchList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="LeadList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:BatchLead">
                                    <StackPanel Padding="0,4" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind DisplayCity}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NextBatchEmpty" Text="No email leads left in the pool."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <Button Content="Queue Next Batch of 20" Style="{StaticResource AccentButtonStyle}"
                            Click="QueueBatchButton_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="Queues the next 20 not-contacted leads that have an email, as the next email batch."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="QueueMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" />
            <TextBlock Text="Loading…" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12" MaxWidth="400">
            <TextBlock Text="Couldn't load today's actions" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Try Again" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Click="RefreshButton_Click" />
        </StackPanel>
    </Grid>
</Page>
