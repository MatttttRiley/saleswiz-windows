<ContentDialog
    x:Class="SalesWiZ.Views.LogReplyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Log reply"
    PrimaryButtonText="Log reply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Name="NoteBox" Header="Note (optional)" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="64"
                 PlaceholderText="What did they say?" />
    </StackPanel>
</ContentDialog>
