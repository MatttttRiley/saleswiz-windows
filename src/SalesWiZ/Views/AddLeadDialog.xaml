<ContentDialog
    x:Class="SalesWiZ.Views.AddLeadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add lead"
    PrimaryButtonText="Add lead"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="AddLeadDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Name="NameBox" Header="Business name" />
        <ComboBox x:Name="IndustryCombo" Header="Industry" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Label" SelectedValuePath="Value" />
        <TextBox x:Name="CityBox" Header="City" />
        <TextBox x:Name="PhoneBox" Header="Phone" InputScope="TelephoneNumber" />
        <TextBox x:Name="EmailBox" Header="Email" InputScope="EmailAddress" />
        <TextBox x:Name="ContactBox" Header="Contact person" />
        <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="64" />
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
