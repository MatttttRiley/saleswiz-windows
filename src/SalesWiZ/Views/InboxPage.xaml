<Page
    x:Class="SalesWiZ.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalesWiZ.Views"
    xmlns:core="using:SalesWiZ">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Inbox" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Compose" Style="{StaticResource AccentButtonStyle}"
                    Click="ComposeButton_Click" VerticalAlignment="Center" />
            <Button Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView x:Name="EmailsList" Grid.Row="1" Margin="0,12,0,0"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="EmailsList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:EmailMessage">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="10" Padding="8,3" VerticalAlignment="Top"
                                Background="{x:Bind local:InboxPage.EmailBadgeBrush(BadgeColorHex)}">
                            <TextBlock Text="{x:Bind BadgeLabel}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Counterpart}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind LeadName}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind local:InboxPage.PrettyDateTime(ReceivedAt)}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMoreButton_Click" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed"
                          Width="24" Height="24" />
            <TextBlock x:Name="ErrorText" Foreground="Red" VerticalAlignment="Center"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
