<ContentDialog
    x:Class="SalesWiZ.Views.LogCallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Log call"
    PrimaryButtonText="Log call"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="LogCallDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="360">
        <ComboBox x:Name="OutcomeCombo" Header="Outcome" HorizontalAlignment="Stretch" />
        <TextBox x:Name="NoteBox" Header="Note (optional)" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="64" />
        <CheckBox x:Name="FollowUpCheck" Content="Set a follow-up date"
                  Checked="FollowUpCheck_Toggled" Unchecked="FollowUpCheck_Toggled" />
        <DatePicker x:Name="FollowUpDate" IsEnabled="False" />
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
