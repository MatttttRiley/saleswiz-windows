<Page
    x:Class="SalesWiZ.Views.LeadDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalesWiZ.Views"
    xmlns:core="using:SalesWiZ">

    <Grid>
        <ScrollViewer x:Name="ContentScroll" Padding="24" Visibility="Collapsed">
            <StackPanel Spacing="16" MaxWidth="860">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="‹ Back" Click="BackButton_Click" />
                    <TextBlock x:Name="NameText" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="StatusBadge" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Contact -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Contact" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="PhoneText" VerticalAlignment="Center" />
                            <Button x:Name="CallButton" Content="Call" Click="CallButton_Click" />
                            <TextBlock x:Name="EmailText" VerticalAlignment="Center" />
                            <Button x:Name="MailButton" Content="Email" Click="MailButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ContactPersonText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SourceText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DatesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="StatusCombo" Width="220" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" />
                            <Button Content="Save status" Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveStatusButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Log call" Click="LogCallButton_Click" />
                            <Button Content="Log reply" Click="LogReplyButton_Click" />
                            <Button Content="Mark bounced" Click="BounceButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ActionMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border x:Name="NotesCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="HistoryList" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:HistoryEvent">
                                    <StackPanel Padding="0,4" Spacing="2">
                                        <TextBlock>
                                            <Run Text="{x:Bind Kind}" FontWeight="SemiBold" />
                                            <Run Text=" — " />
                                            <Run Text="{x:Bind local:LeadDetailPage.PrettyDate(EventDate)}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Emails -->
                <Border x:Name="EmailsCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Emails" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="EmailsList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="EmailsList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:EmailMessage">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="10" Padding="8,3" VerticalAlignment="Top"
                                                Background="{x:Bind local:LeadDetailPage.EmailBadgeBrush(BadgeColorHex)}">
                                            <TextBlock Text="{x:Bind BadgeLabel}" Foreground="White"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Counterpart}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" />
            <TextBlock Text="Loading…" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12" MaxWidth="400">
            <TextBlock Text="Couldn't load the lead" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Try Again" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Page>
