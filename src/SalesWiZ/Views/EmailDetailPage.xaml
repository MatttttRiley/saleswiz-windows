<Page
    x:Class="SalesWiZ.Views.EmailDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalesWiZ.Views"
    xmlns:core="using:SalesWiZ">

    <Grid>
        <ScrollViewer x:Name="ContentScroll" Padding="24" Visibility="Collapsed">
            <StackPanel Spacing="16" MaxWidth="860">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="‹ Back" Click="BackButton_Click" />
                    <TextBlock x:Name="SubjectText" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="BadgeBorder" CornerRadius="10" Padding="8,3">
                                <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="DateText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="FromText" />
                        <TextBlock x:Name="ToText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="ErrorText2" Foreground="Red" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ReplyButton" Content="Reply" Style="{StaticResource AccentButtonStyle}"
                                    Click="ReplyButton_Click" />
                            <Button x:Name="LeadButton" Content="Open lead" Click="LeadButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ThreadCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Thread" FontSize="16" FontWeight="SemiBold" />
                        <ListView x:Name="ThreadList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="ThreadList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:EmailMessage">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="10" Padding="8,3" VerticalAlignment="Top"
                                                Background="{x:Bind local:EmailDetailPage.EmailBadgeBrush(BadgeColorHex)}">
                                            <TextBlock Text="{x:Bind BadgeLabel}" Foreground="White"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Counterpart}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind local:EmailDetailPage.PrettyDateTime(ReceivedAt)}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" />
            <TextBlock Text="Loading…" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
