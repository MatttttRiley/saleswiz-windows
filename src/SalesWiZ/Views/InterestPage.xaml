<Page
    x:Class="SalesWiZ.Views.InterestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalesWiZ.Views"
    xmlns:core="using:SalesWiZ">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Interest" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView x:Name="InterestList" Grid.Row="1" Margin="0,12,0,0"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="InterestList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:Lead">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind local:InterestPage.Initial(Industry)}"
                                       Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind DisplayCity}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ReplySnippet}" TextWrapping="Wrap" MaxLines="2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind local:InterestPage.RepliedText(DateReplied)}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="0,24,0,0" Visibility="Collapsed"
                   Text="No replies yet. When someone answers your outreach, they show up here."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</Page>
