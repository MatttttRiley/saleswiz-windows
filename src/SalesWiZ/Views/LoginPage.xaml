<UserControl
    x:Class="SalesWiZ.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="420" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="32">
            <!-- App mark: navy rounded square, white W, copper rule. -->
            <Grid Width="112" Height="112" HorizontalAlignment="Center">
                <Rectangle RadiusX="28" RadiusY="28" Fill="{StaticResource SalesNavyBrush}" />
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="W" FontSize="56" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <Rectangle Width="44" Height="6" RadiusX="3" RadiusY="3"
                               Fill="{StaticResource SalesCopperBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="SalesWiZ" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="One home for every lead." FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="12">
                <PasswordBox x:Name="PasswordInput" PlaceholderText="Password"
                             PasswordRevealMode="Peek" KeyDown="PasswordInput_KeyDown" />
                <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="13"
                           Visibility="Collapsed" TextWrapping="Wrap" />
                <Button x:Name="LoginButton" Content="Log in" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="LoginButton_Click" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" Width="28" Height="28" />
            </StackPanel>

            <TextBlock Text="Shared login for Matt + Philbert." FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
