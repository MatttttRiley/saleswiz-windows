<Application
    x:Class="SalesWiZ.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Brand colors, same as the web CRM and the iPhone app. -->
            <SolidColorBrush x:Key="SalesNavyBrush" Color="#FF1B2F4A" />
            <SolidColorBrush x:Key="SalesCopperBrush" Color="#FFE8A34C" />
            <SolidColorBrush x:Key="SalesNavyDarkBrush" Color="#FF14263C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
